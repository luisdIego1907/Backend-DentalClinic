{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:dentalclinic-server.database.windows.net,1433;Initial Catalog=DentalClinicDB;Persist Security Info=False;User ID=dentalclinic-sa;Password={your_password};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5174"]
  },

  "RateLimiting": {
    "PermitLimit": 6,
    "WindowSeconds": 60,
    "QueueLimit": 8
  },

  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Secret": "",
    "ExpirationMinutes": 60
  },

  "AllowedHosts": "*"
}
